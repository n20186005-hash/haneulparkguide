---
import { getI18n } from '../i18n/ui';
import attraction from '../config/attraction';

const { messages } = getI18n(Astro.url);
const s = messages.sources;
---

<section id="sources" class="section-padding" style="background: var(--bg-tertiary); border-top: 1px solid var(--border-color);">
  <div class="max-w-5xl mx-auto px-4">
    <div class="max-w-3xl mx-auto text-center mb-10">
      <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3" style="color: var(--text-primary);">{s.title}</h2>
      <p class="text-base sm:text-lg leading-relaxed" style="color: var(--text-secondary);">{s.subtitle}</p>
    </div>

    <div class="grid md:grid-cols-2 gap-6 mb-8">
      {s.items.map((item: any) => (
        <a
          href={item.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-start gap-4 rounded-2xl p-5 border transition hover:-translate-y-0.5"
          style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);"
        >
          <span class="shrink-0 text-2xl" aria-hidden="true">🔗</span>
          <div>
            <h3 class="font-semibold mb-1 group-hover:opacity-80" style="color: var(--text-primary);">{item.name}</h3>
            <p class="text-sm leading-relaxed" style="color: var(--text-secondary);">{item.description}</p>
          </div>
        </a>
      ))}
    </div>

    <div class="rounded-2xl p-6 border text-center" style="background: var(--card-bg); border-color: var(--border-color);">
      <p class="text-sm mb-2" style="color: var(--text-secondary);">{s.imageCredit}</p>
      <p class="text-xs" style="color: var(--text-muted);">{s.lastUpdated}</p>
    </div>
  </div>
</section>
