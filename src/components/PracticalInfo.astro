---
import { getI18n } from '../i18n/ui';

const { messages } = getI18n(Astro.url);
const p = messages.practicalInfo;
const groups = p.groups ?? [];
---

<section id="practical" class="section-padding" style="background: var(--bg-primary);">
  <div class="max-w-6xl mx-auto px-4">
    <div class="max-w-3xl mx-auto text-center mb-10">
      <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3" style="color: var(--text-primary);">{p.title}</h2>
      <p class="text-base sm:text-lg leading-relaxed" style="color: var(--text-secondary);">{p.subtitle}</p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {groups.map((group) => (
        <article
          class="rounded-2xl p-6 border h-full flex flex-col"
          style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);"
        >
          <div class="flex items-center gap-3 mb-3">
            <span class="text-2xl shrink-0" aria-hidden="true">{group.icon}</span>
            <h3 class="text-lg font-semibold" style="color: var(--text-primary);">{group.title}</h3>
          </div>

          <p class="text-sm leading-relaxed mb-4" style="color: var(--text-secondary);">{group.summary}</p>

          {group.points && (
            <ul class="mt-auto space-y-2 text-sm leading-relaxed" style="color: var(--text-secondary);">
              {group.points.map((point) => (
                <li class="flex gap-2">
                  <span class="shrink-0" style="color: var(--accent);" aria-hidden="true">•</span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          )}
        </article>
      ))}
    </div>

    {p.neutralNote && (
      <p
        class="max-w-4xl mx-auto mt-8 rounded-2xl border px-5 py-4 text-sm leading-relaxed text-center"
        style="background: var(--bg-tertiary); border-color: var(--border-color); color: var(--text-secondary);"
      >
        {p.neutralNote}
      </p>
    )}
  </div>
</section>
